{
	// Cloudflare Wrangler configuration for the API Worker
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "api-hang-dev",
	"main": "src/index.ts",
	"compatibility_date": "2025-07-09",
	"workers_dev": false,

	// Observability
	"observability": {
		"logs": {
			"enabled": true
		}
	},

	// Local development settings
	"dev": {
		"port": 3000,
		"ip": "0.0.0.0"
	},

	// D1 database bindings
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "db-hang-dev",
			"database_id": "db-hang-dev"
		}
	],

	// R2 bucket bindings
	"r2_buckets": [
		{
			"binding": "PUBLIC",
			"bucket_name": "public-hang-dev"
		}
	],

	// Environment variables for development
	"vars": {
		"API_URL": "http://localhost:3000",
		"APP_URL": "http://localhost:1420",

		// "AUTH_SECRET": <set by `just api dev`>

		"GOOGLE_CLIENT_ID": "632186286103-6g3knqa8eof9p4bf1ndedgn9r6g68n73.apps.googleusercontent.com",
		// "GOOGLE_CLIENT_SECRET": <stored in .dev.vars>

		"DISCORD_CLIENT_ID": "1392633766010294494",
		// "DISCORD_CLIENT_SECRET": <stored in .dev.vars>

		// NOTE: Apple requires HTTPS and a non localhost domain.
		//"APPLE_CLIENT_ID": "dev.hang.service",
		//"APPLE_TEAM_ID": "D7D5SDDB5Z",
		//"APPLE_KEY_ID": "964W676BWT",
		// "APPLE_CLIENT_SECRET": <stored in .dev.vars>

		"R2_PUBLIC_URL": "http://localhost:3000/public",

		"RELAY_URL": "http://localhost:4443",
		"RELAY_PREFIX": "demo"
		// "RELAY_SECRET": <stored in .dev.vars, set dynamically>
	},

	"env": {
		// Staging, deployed from every merge to main, with its own data so its migrations and uploads never touch production's.
		"staging": {
			"name": "api-hang-staging",
			"account_id": "dd618f5dbd5da77b8296f1613c301f5c",
			"route": {
				"pattern": "api.new.hang.live",
				"custom_domain": true
			},
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "db-hang-staging",
					"database_id": "1f96befd-ddc2-4d69-afd1-cae466c6fd0c"
				}
			],
			"r2_buckets": [
				{
					"binding": "PUBLIC",
					"bucket_name": "public-hang-staging"
				}
			],
			"vars": {
				"API_URL": "https://api.new.hang.live",
				"APP_URL": "https://new.hang.live",

				// "AUTH_SECRET": bun wrangler secret put AUTH_SECRET --env staging

				"GOOGLE_CLIENT_ID": "1093943946174-915g0a9jpu7gih5emghmtabhge29qgg2.apps.googleusercontent.com",
				// "GOOGLE_CLIENT_SECRET": from bws hang-staging-google-client-secret

				"DISCORD_CLIENT_ID": "1392629623812259940",
				// "DISCORD_CLIENT_SECRET": from bws hang-staging-discord-client-secret

				"APPLE_CLIENT_ID": "now.hang.api",
				"APPLE_TEAM_ID": "D7D5SDDB5Z",
				"APPLE_KEY_ID": "KMX7K7944B",
				// "APPLE_CLIENT_SECRET": the key's base64 .p8 body, from bws hang-staging-apple-key

				"R2_PUBLIC_URL": "https://public.new.hang.live",

				// Staging rooms live under their own root, which staging's relay key alone can sign for.
				"RELAY_URL": "https://cdn.moq.dev",
				"RELAY_PREFIX": "staging"
				// "RELAY_SECRET": bun wrangler secret put RELAY_SECRET --env staging
			}
		},

		// Live/production environment overrides
		"live": {
			"name": "api-hang-live",
			"account_id": "dd618f5dbd5da77b8296f1613c301f5c",
			"route": {
				"pattern": "api.hang.live",
				"custom_domain": true
			},
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "db-hang-live",
					"database_id": "2ce27c69-eae1-4633-9b8b-7eb55dc6ebb8"
				}
			],
			"r2_buckets": [
				{
					"binding": "PUBLIC",
					"bucket_name": "public-hang-live"
				}
			],
			"vars": {
				"API_URL": "https://api.hang.live",
				"APP_URL": "https://hang.live",

				// "AUTH_SECRET": npx wrangler secret put AUTH_SECRET --env live

				"GOOGLE_CLIENT_ID": "632186286103-p5k3rhlsq1bgkku7dluko4nlv4ca4hao.apps.googleusercontent.com",
				// "GOOGLE_CLIENT_SECRET": npx wrangler secret put GOOGLE_CLIENT_SECRET --env live

				"DISCORD_CLIENT_ID": "1389725440020840548",
				// "DISCORD_CLIENT_SECRET": npx wrangler secret put DISCORD_CLIENT_SECRET --env live

				"APPLE_CLIENT_ID": "live.hang.api",
				"APPLE_TEAM_ID": "D7D5SDDB5Z",
				"APPLE_KEY_ID": "Q7CN38JH2Z",
				// "APPLE_CLIENT_SECRET": npx wrangler secret put APPLE_CLIENT_SECRET --env live

				"R2_PUBLIC_URL": "https://public.hang.live",

				"RELAY_URL": "https://cdn.moq.dev",
				"RELAY_PREFIX": "hang"
				// "RELAY_SECRET": npx wrangler secret put RELAY_SECRET --env live
			}
		}
	}
}
