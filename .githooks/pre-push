#!/bin/sh
# Run the repository's CI before every push, so a failure surfaces here instead of in the merge queue.
# Delete this hook once this repository's kixel.quest merge queue is live.
set -e
# core.hooksPath replaces .git/hooks, so Git LFS's own pre-push hook runs here (it reads the refs from stdin).
git lfs pre-push "$@"
if [ -f flake.nix ]; then
	exec nix develop --command just ci
fi
exec just ci
