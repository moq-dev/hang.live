#!/usr/bin/env just --justfile

set fallback

dev:
	just ../dev/auth-key
	bun wrangler d1 migrations apply DB --local
	# Guest credentials and sessions need a signing secret; this one is only trusted by the local API.
	bun wrangler dev --var "RELAY_SECRET:$(cat ../dev/root.jwk)" --var "RELAY_URL:http://localhost:4443" --var "AUTH_SECRET:local-development-only"

build:
	bun run build

check:
	bun run check

fix:
	bun wrangler types

deploy: build
	bun wrangler d1 migrations apply DB --env live --remote
	bun wrangler deploy --env live
