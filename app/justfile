#!/usr/bin/env just --justfile

set fallback

# Build the packages
build env="development":
	bun run deps
	bun vite build --mode "{{env}}"

# Refuse to ship the Git LFS pointer files a checkout without LFS content holds in place of media.
lfs:
	@if grep -rlx 'version https://git-lfs.github.com/spec/v1' public; then echo "error: these are Git LFS pointers; run git lfs pull" >&2; exit 1; fi

# Deploy the site to Cloudflare Workers
deploy: lfs
	just build live
	bun wrangler deploy --env live

# Run the app in development mode
dev:
	bun vite dev
