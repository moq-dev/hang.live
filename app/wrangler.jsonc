{
	// Check the configuration file schema, the main reason why we're not using TOML.
	"$schema": "./node_modules/wrangler/config-schema.json",

	// Cloudflare Workers static assets serving the built app.
	"name": "hang-dev",
	"compatibility_date": "2025-07-09",

	"assets": {
		"directory": "./dist",
		"not_found_handling": "single-page-application"
	},

	// `wrangler dev` previews the built app on Vite's port, the only origin the local API allows.
	"dev": {
		"port": 1420
	},

	"env": {
		// Staging, deployed from every merge to main.
		"staging": {
			"name": "hang-staging",
			"account_id": "dd618f5dbd5da77b8296f1613c301f5c",
			"route": {
				"pattern": "new.hang.live",
				"custom_domain": true
			}
		},

		// Production environment configuration
		"live": {
			"name": "hang-live",
			"account_id": "dd618f5dbd5da77b8296f1613c301f5c",
			"route": {
				"pattern": "hang.live",
				"custom_domain": true
			}
		}
	}
}
