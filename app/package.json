{
	"name": "@hang/live",
	"private": true,
	"version": "0.1.0",
	"description": "",
	"type": "module",
	"scripts": {
		"build": "bun run deps && bunx --bun vite build --mode live",
		"check": "bun run --cwd ../api build && tsc --noEmit && biome check",
		"deps": "bun run --cwd ../api build && bun run --cwd ../moq/js/libav build",
		"fix": "biome check --fix",
		"test": "bun test --isolate --conditions=browser --preload ./test/setup.ts",
		"smoke": "bun test/smoke.ts",
		"test:media": "bun run deps && tsc --project test/tsconfig.json && bun test ./test/media.browser.ts"
	},
	"license": "MIT",
	"dependencies": {
		"@fontsource-variable/montserrat": "^5.2.6",
		"@hang/api": "workspace:*",
		"@moq/clock": "workspace:*",
		"@moq/hang": "workspace:*",
		"@moq/json": "workspace:*",
		"@moq/net": "workspace:*",
		"@moq/publish": "workspace:*",
		"@moq/room": "workspace:*",
		"@moq/signals": "workspace:*",
		"@moq/ui": "workspace:*",
		"@moq/watch": "workspace:*",
		"@solidjs/router": "^0.16.3",
		"@tailwindcss/vite": "^4.3.5",
		"comlink": "^4.4.2",
		"dompurify": "^3.5.0",
		"hono": "^4.13.22",
		"kokoro-js": "^1.2.1",
		"marked": "^18.3.0",
		"solid-js": "^1.9.20",
		"tailwindcss": "^4.3.5",
		"zod": "^4.1.3"
	},
	"devDependencies": {
		"@babel/core": "7.29.13",
		"@babel/preset-typescript": "^7.29.0",
		"@happy-dom/global-registrator": "21.0.4",
		"@iconify-json/material-symbols": "^1.2.101",
		"@iconify-json/mdi": "^1.2.3",
		"@iconify/tailwind4": "^1.0.6",
		"@tailwindcss/typography": "^0.5.16",
		"@types/babel__core": "7.20.5",
		"@types/bun": "^1.4.5",
		"@types/jsdom": "^30.0.0",
		"babel-preset-solid": "1.9.19",
		"jsdom": "^31.0.1",
