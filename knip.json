{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"workspaces": {
		".": {},
		"api": {
			"entry": ["test/**/*.ts"],
			"project": ["src/**/*.ts", "test/**/*.ts"]
		},
		"app": {
			"entry": ["src/**/*.test.ts", "test/**/*.{ts,tsx}", "src/room/chat-worker.ts", "src/room/tts/worker.ts"],
			"project": ["src/**/*.{ts,tsx,css}", "test/**/*.{ts,tsx}"]
		}
	},
	"ignoreWorkspaces": ["moq/**"],
	"ignoreExportsUsedInFile": true,
	"rules": {
		"dependencies": "off",
		"devDependencies": "off",
		"optionalPeerDependencies": "off",
		"unlisted": "off",
		"binaries": "off",
		"unresolved": "off"
	}
}
