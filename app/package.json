	"version": "0.1.0",
	"description": "",
	"type": "module",
	"scripts": {
		"dev": "bunx --bun vite --open",
		"build": "bun run deps && bunx --bun vite build",
		"check": "bun run --cwd ../api build && tsc --noEmit && biome check",
		"deps": "bun run --cwd ../api build && bun run --cwd ../moq/js/libav build",
		"fix": "biome check --fix",
		"tauri": "tauri",
		"test": "bun test --isolate --conditions=browser --preload ./test/setup.ts src",
		"test:media": "bun run deps && tsc --project test/tsconfig.json && bun test ./test/media.browser.ts"
	},
