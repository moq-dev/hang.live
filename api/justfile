#!/usr/bin/env just --justfile

set fallback

dev:
	just ../dev/auth-key
	bun wrangler d1 migrations apply DB --local
	bun wrangler dev --var "RELAY_SECRET:$(cat ../dev/root.jwk)"

build:
	bun run build

check:
	bun run check

# Regenerate worker-configuration.d.ts from wrangler.jsonc.
types:
	bun wrangler types

deploy: build
	bun wrangler d1 migrations apply DB --env live --remote
	bun wrangler deploy --env live
